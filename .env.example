# ==============================================================================
# CONTENTSTACK CONFIGURATION (Verplicht)
# ==============================================================================
# De unieke identifier van je Contentstack Stack (Settings > Stack > API Key)
NEXT_PUBLIC_CONTENTSTACK_API_KEY=blt_your_stack_api_key_here

# Read-only Delivery Token voor het ophalen van gepubliceerde content
# (Settings > Tokens > Delivery Tokens - geeft GEEN beheer- of schrijfrechten)
NEXT_PUBLIC_CONTENTSTACK_DELIVERY_TOKEN=cs_your_delivery_token_here

# Preview Token voor Contentstack Live Preview en Visual Builder
# (Settings > Tokens > Delivery Tokens > Preview Token)
NEXT_PUBLIC_CONTENTSTACK_PREVIEW_TOKEN=cs_your_preview_token_here

# De doelomgeving in Contentstack (bijv. production, development of preview)
NEXT_PUBLIC_CONTENTSTACK_ENVIRONMENT=production

# Datacenter regio: 'EU' (Europa), 'NA' (Noord-Amerika) of 'AZURE_NA'
NEXT_PUBLIC_CONTENTSTACK_REGION=EU

# Schakel Contentstack Live Preview / Visual Builder in ('true' of 'false')
NEXT_PUBLIC_CONTENTSTACK_PREVIEW=false

# ==============================================================================
# WEBSITE & ASSET INSTELLINGEN (Aanbevolen)
# ==============================================================================
# Basis URL voor canonical metadata, OpenGraph en sitemap generatie
NEXT_PUBLIC_SITE_URL=https://www.edwinschipper.nl

# CDN Hostname voor Contentstack afbeeldingen
NEXT_PUBLIC_CONTENTSTACK_IMAGE_HOSTNAME=eu-images.contentstack.com

# ==============================================================================
# ANALYTICS (Optioneel)
# ==============================================================================
# Google Tag Manager Container ID (bijv. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

